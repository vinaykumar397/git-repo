
 Step 1: Use a lightweight Python base image
FROM python:3.10-slim

# Step 2: Set working directory
WORKDIR /app

# Step 3: Copy app files into the container
COPY app.py /app

# Step 4: Install Flask
RUN pip install flask

# Step 5: Expose port 5000 for web access
EXPOSE 5000

# Step 6: Run the app
CMD ["python", "app.py"]
