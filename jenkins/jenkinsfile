pipeline {
agent any
stages{
stage ('build') {
steps{
sh '''
     echo "Listing WORKSAPCE contents:"
ls -l ${WORKSPACE}
echo "Build stage is completed"
echo " next stage is deploy"
'''
}
}
stage ('deploy') {
steps{
sh '''
     echo " Executing the script.sh"
      bash ${WORKSAPCE}/linus/script.sh
echo "Deploying is completed"
'''
}
}

}
}
